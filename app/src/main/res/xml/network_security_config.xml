<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- System roots only: a user-installed certificate must not be able to intercept browsing silently. -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
